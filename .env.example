# Copy this file to .env and fill in the values. NEVER commit .env (it is in .gitignore).

# Google AI Studio API key (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# Text-generation model used for ticket triage (must appear in the list printed by check_setup.py)
GEMINI_MODEL=gemini-3.5-flash-lite

# Model that writes the synthetic tickets and SOP documents (separate daily quota)
DATA_GEN_MODEL=gemini-3.1-flash-lite

# Embedding model and vector size (768 keeps storage small and is a recommended size)
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Free-tier safety: how many Gemini requests per minute our scripts may send.
# Check your real limit in AI Studio > Dashboard > Rate limits and lower/raise this.
REQUESTS_PER_MINUTE=10

# Postgres + pgvector (Docker container, see README)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ticket_triage
DB_USER=postgres
DB_PASSWORD=

# Triage tuning (optional, these are the defaults)
CONFIDENCE_THRESHOLD=0.75
MIN_RETRIEVAL_SIMILARITY=0.55
TOP_K=3

# Tickets in these predicted priorities / categories always go to a person (comma separated)
REVIEW_PRIORITIES=High,Urgent
REVIEW_CATEGORIES=Billing & Payments

# Optional: link shown in the dashboard footer
DASHBOARD_REPO_URL=
